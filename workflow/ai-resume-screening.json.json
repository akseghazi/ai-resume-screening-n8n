      "parameters": {
        "jsonSchemaExample": "{\n  \"candidate_name\": \"Ali Khan\",\n  \"email\": \"ali.khan@example.com\",\n  \"phone\": \"+92 300 1234567\",\n  \"education\": \"Bachelor of Science in Computer Science\",\n  \"experience_years\": 3,\n  \"technical_skills\": [\n    \"Python\",\n    \"n8n\",\n    \"REST APIs\",\n    \"SQL\"\n  ],\n  \"matching_required_skills\": [\n    \"Python\",\n    \"n8n\",\n    \"REST APIs\",\n    \"SQL\"\n  ],\n  \"missing_required_skills\": [\n    \"AWS\"\n  ],\n  \"matching_preferred_skills\": [\n    \"Docker\",\n    \"Git\",\n    \"Supabase\",\n    \"PostgreSQL\"\n  ],\n  \"strengths\": [\n    \"Strong automation experience\",\n    \"Relevant technical skills\"\n  ],\n  \"weaknesses\": [\n    \"Limited AWS experience\"\n  ],\n  \"score\": 88,\n  \"recommendation\": \"SHORTLIST\",\n  \"reason\": \"The candidate matches most of the required skills and has relevant automation experience.\"\n}"
